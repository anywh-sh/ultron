# Copy to `.env` and adjust. `npm run dev` and `npm start` both load this
# file automatically (via node's --env-file-if-exists), and the systemd unit
# reads it through EnvironmentFile= — so the same file works either way. A
# real environment variable always wins over a value set here.
#
# Every setting below is optional: the relay runs on its built-in defaults
# when started from a shell that already has `claude` on PATH.

# Absolute path to the `claude` binary. Defaults to the bare name "claude",
# resolved via the relay process's own PATH.
# CLAUDE_BIN=/home/user/.local/bin/claude

# Colon-separated extra directories prepended to the PATH of every spawned
# `claude` child process — for tools Claude Code itself invokes (node, git,
# a Node version manager's shim dir...) that wouldn't otherwise be found by
# name alone under systemd.
# EXTRA_PATH_DIRS=/home/user/.local/bin:/home/user/.nvm/versions/node/v20.19.0/bin

# Port and bind address for the relay's HTTP/WebSocket server.
# RELAY_PORT=8765
# RELAY_HOST=0.0.0.0

# Where to persist session/background-job state across restarts.
# RELAY_SESSIONS_FILE=/home/user/.ultron-sessions/default.json
# RELAY_BACKGROUND_JOBS_FILE=/home/user/.ultron-sessions/default-bg-jobs.json

# Directory for uploaded files (images pasted/sent from the client).
# RELAY_UPLOAD_DIR=/tmp/ultron-uploads

# Overrides $HOME for the spawned `claude` process — used to run a second,
# fully isolated profile (separate ~/.claude config) alongside the default one.
# RELAY_HOME_OVERRIDE=/home/user/.ultron-work-home

# Absolute path to the `tmux` binary (used by the terminal/tmux session
# feature). Defaults to the standard system location.
# TMUX_BIN=/usr/bin/tmux

# How long (ms) the relay waits for in-flight turns to finish before a
# restart/shutdown forces them closed. Defaults to 4 minutes.
# RELAY_SHUTDOWN_GRACE_MS=240000

[Unit]
Description=ultron - terminal web (ttyd+tmux) para o perfil pessoal (claude)
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
User=youruser
WorkingDirectory=/home/user
ExecStart=/home/user/.local/bin/ttyd --writable -p 7681 -i tailscale0 tmux -L claude-pessoal new-session -A -s claude-pessoal
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

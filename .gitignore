# node
# No trailing slash on purpose: `node_modules/` matches directories only, and
# a git worktree whose deps are a symlink to the main checkout's (a normal way
# to avoid a second full install) then has a trackable `node_modules` that
# `git add -A` will happily commit as a symlink to an absolute local path.
# Happened once; the client's own .gitignore already spelled it this way.
node_modules
dist/
relay/sessions.local.json
relay/.env

# systemd (rendered from *.service.template — machine-specific paths)
infra/systemd/anywh-relay@.service

# rust / tauri
client/src-tauri/target/
client/src-tauri/gen/

# tailnet-sidecar Go binaries, one per platform target triple (journal/62
# CT-2) — built from client/tailnet-sidecar/, not checked in
client/src-tauri/binaries/

# personal convenience scripts (see client/README.md) — machine-specific,
# e.g. a physical iOS device name, never meant to be shared
client/*.local.sh

# os
.DS_Store
Screenshot*.png
.playwright-mcp/

# Loaded only by `vite build --mode e2e` (npm run build:frontend:e2e), which
# is what tauri.e2e.conf.json's beforeBuildCommand runs. It exists to flip
# the one test-only branch in src/main.tsx on; a normal dev/build never sees
# it, so the WebdriverIO frontend plugin stays out of the shipped bundle.
VITE_E2E=true
